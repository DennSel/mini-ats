# Public keys (bundled into client-side JS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only key (bypass RLS - NEVER prefix with VITE_)
# Add this as an environment secret in your deployment platform (Vercel, Netlify, Railway, Render, Docker, etc.)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key